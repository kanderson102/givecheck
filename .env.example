# Neon Postgres
DATABASE_URL=postgresql://user:password@host.neon.tech/givecheck?sslmode=require

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CONNECT_CLIENT_ID=ca_...   # Stripe Dashboard → Settings → Connect → OAuth settings
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe Dashboard → Developers → Webhooks

# Encryption key for Stripe restricted keys stored in DB (64-char hex = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STRIPE_KEY_ENCRYPTION_KEY=

# Every.org
EVERY_ORG_API_KEY=...
EVERY_ORG_WEBHOOK_SECRET=...   # HMAC secret for Partner Webhook signature verification

# Vercel Cron
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
